{
  "manifest_version": "0.3",
  "name": "webprofile-pp-mcp",
  "display_name": "Webprofile",
  "version": "4.0.5",
  "description": "Pulls UN Comtrade trade-flow data for ocean-freight prospect research; given country + HS code, returns who imports what from where.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/webprofile-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/webprofile-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
